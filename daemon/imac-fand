#!/usr/bin/env python3
"""Drive the iMac's single fan from every temperature sensor it has.

mbpfan only looks at coretemp, so a GPU-only load (a game, glmark2) cooks
the Radeon while the fan sits at its 1200 rpm floor. CPU and GPU alone are
not enough either: streaming a full-screen 4K picture at 60 fps kept both
near 60°C, the fan near its floor, and the memory (SMC TM1a) climbed until
the SMC cut the power. Every second this daemon reads coretemp, amdgpu and
all of the SMC's own probes, puts each on the curve for its kind of sensor,
and sets the SMC's fan target from whichever asks for the most.

Runs as root under systemd, independent of the shell: if the bar plugin or
the whole desktop dies, the fan keeps being regulated. On exit the fan is
handed back to the SMC's own automatic control, and the unit's
ExecStopPost does the same in case this process is killed outright.

The mode (silent / normal / full) comes from a one-word file the desktop
user may write; anything that is not a known mode reads as "normal".
"""
import glob
import json
import os
import signal
import sys
import time
from collections import namedtuple

MODE_FILE = "/var/lib/imac-fan/mode"
STATUS_FILE = "/run/imac-fan/status.json"
INTERVAL = 1.0

# Curves per kind of sensor as (temp where the fan leaves its floor, temp
# where it reaches max), in normal mode. The Radeon idles around 55°C on the
# desktop, so its knee sits above that or the fan would never rest. Memory
# reached 68°C (TM1a) with the fan at full speed under the 4K stream; with the
# fan near its floor the SMC powered the iMac off. Showing a desktop it idles
# at 53–54°C (TM1a, TM2d, next to the GPU), so its knee sits above that too:
# with it at 50°C the fan never went below ~1500 rpm.
CURVES = {
    "cpu": (60, 85),
    "gpu": (60, 85),
    "memory": (58, 72),
    "board": (60, 80),
}
# Silent mode moves both knees up by this much.
SILENT_SHIFT = (8, 5)

# The SMC reports absent or broken probes as -127, 0, 1 and similar; nothing
# inside a running iMac is really below this.
PLAUSIBLE = (20, 127)

# Whatever the mode, this hot means full speed. The i5-4690 throttles at
# 100°C and the GPU's own crit is 120°C; 90°C is well short of either.
PANIC_TEMP = 90

# Ramp limits per tick. Up is fast so a load spike is met within a couple of
# seconds; down is slow so the fan doesn't hunt on bursty loads.
RAMP_UP_RPM = 400
RAMP_DOWN_RPM = 40
# Changes smaller than this are not worth an SMC write.
DEADBAND_RPM = 20


# Where fan1 lives and what its controls are called. Up to kernel 7.2.5
# applesmc had its own fan1_manual (1 manual, 0 auto) and fan1_output on the
# platform device. Its conversion to hwmon_device_register_with_info (in
# linux-omarchy 7.2.8) renamed them, with no aliases, to the standard
# pwm1_enable (1 manual, 2 auto) and fan1_target under hwmon/hwmon*.
Fan = namedtuple("Fan", "base enable target manual auto")


def smc_fan():
    for path in glob.glob("/sys/devices/platform/applesmc.*"):
        if os.path.exists(os.path.join(path, "fan1_output")):
            return Fan(path, "fan1_manual", "fan1_output", 1, 0)
        for hwmon in glob.glob(path + "/hwmon/hwmon*"):
            if os.path.exists(os.path.join(hwmon, "fan1_target")):
                return Fan(hwmon, "pwm1_enable", "fan1_target", 1, 2)
    return None


def hwmon_chip(name):
    for f in glob.glob("/sys/class/hwmon/hwmon*/name"):
        try:
            if open(f).read().strip() == name:
                return os.path.dirname(f)
        except OSError:
            pass
    return None


def read_int(path):
    try:
        return int(open(path).read().strip())
    except (OSError, ValueError):
        return None


def write_int(path, value):
    try:
        with open(path, "w") as f:
            f.write(str(int(value)))
        return True
    except OSError:
        return False


def temp_by_label(base, label):
    if not base:
        return None
    for f in glob.glob(base + "/temp*_label"):
        try:
            if open(f).read().strip() != label:
                continue
        except OSError:
            continue
        value = read_int(f[:-len("_label")] + "_input")
        return value / 1000 if value is not None else None
    return None


def cpu_temp():
    return temp_by_label(hwmon_chip("coretemp"), "Package id 0")


def gpu_temp(smc):
    # amdgpu's edge sensor first; the SMC's own GPU die probe (TG0D) tracks
    # it within a degree and covers the case where amdgpu isn't loaded.
    t = temp_by_label(hwmon_chip("amdgpu"), "edge")
    if t is None:
        t = temp_by_label(smc, "TG0D")
    # The SMC reports absent probes as -127 and similar; ignore nonsense.
    return t if t is not None and 0 < t < 150 else None


def kind(label):
    # Apple's key names: TC CPU, TG GPU, TM/Tm memory; the rest (PCH, power
    # supply, SSD, LCD, air) count as board.
    if label.startswith("TC"):
        return "cpu"
    if label.startswith("TG"):
        return "gpu"
    if label.startswith(("TM", "Tm")):
        return "memory"
    return "board"


def smc_probes(smc):
    """{input file: label} for every SMC temperature."""
    probes = {}
    for f in glob.glob(smc + "/temp*_label"):
        try:
            probes[f[:-len("_label")] + "_input"] = open(f).read().strip()
        except OSError:
            pass
    return probes


def readings(smc, probes):
    """[(name, kind, temp)] for every sensor that answers with a sane value."""
    found = [("cpu", "cpu", cpu_temp()), ("gpu", "gpu", gpu_temp(smc))]
    for path, label in probes.items():
        value = read_int(path)
        if value is not None:
            found.append((label, kind(label), value / 1000))
    return [(n, k, t) for n, k, t in found if t is not None and PLAUSIBLE[0] <= t < PLAUSIBLE[1]]


def read_mode():
    try:
        with open(MODE_FILE) as f:
            mode = f.read(16).strip()
    except OSError:
        return "normal"
    return mode if mode in ("silent", "normal", "full") else "normal"


def demand(temp, sensor_kind, mode):
    """How far along its curve a sensor is: 0 at the floor, 1 at max."""
    start, end = CURVES[sensor_kind]
    if mode == "silent":
        start, end = start + SILENT_SHIFT[0], end + SILENT_SHIFT[1]
    if sensor_kind in ("cpu", "gpu") and temp >= PANIC_TEMP:
        return 1.0
    return min(1.0, max(0.0, (temp - start) / (end - start)))


def curve_target(found, mode, lo, hi):
    """The fan target and the sensor that set it, as (rpm, (name, kind, temp))."""
    # No sensor at all means flying blind: run at max rather than min.
    if not found:
        return hi, None
    # The sensor asking for the most; at rest, the hottest of CPU and GPU.
    driver = max(found, key=lambda r: (demand(r[2], r[1], mode), r[1] in ("cpu", "gpu"), r[2]))
    if mode == "full":
        return hi, driver
    return lo + (hi - lo) * demand(driver[2], driver[1], mode), driver


def write_status(status):
    try:
        os.makedirs(os.path.dirname(STATUS_FILE), exist_ok=True)
        tmp = STATUS_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(status, f)
        os.chmod(tmp, 0o644)
        os.replace(tmp, STATUS_FILE)
    except OSError:
        pass


def release(fan):
    write_int(os.path.join(fan.base, fan.enable), fan.auto)


def main():
    fan = smc_fan()
    if not fan:
        print("applesmc fan not found", file=sys.stderr)
        return 1
    smc = fan.base
    enable = os.path.join(smc, fan.enable)
    target = os.path.join(smc, fan.target)

    lo = read_int(os.path.join(smc, "fan1_min")) or 1200
    hi = read_int(os.path.join(smc, "fan1_max")) or 2700
    probes = smc_probes(smc)

    def stop(signum, frame):
        release(fan)
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    if not write_int(enable, fan.manual):
        print("cannot take manual control of fan1", file=sys.stderr)
        return 1

    current = read_int(target) or lo
    try:
        while True:
            mode = read_mode()
            found = readings(smc, probes)
            temps = {n: t for n, _, t in found}
            want, driver = curve_target(found, mode, lo, hi)
            if want > current:
                step = min(want, current + RAMP_UP_RPM)
            else:
                step = max(want, current - RAMP_DOWN_RPM)
            step = int(round(max(lo, min(hi, step))))

            if abs(step - current) >= DEADBAND_RPM or step in (lo, hi):
                if step != current:
                    write_int(target, step)
                current = step
            # The SMC drops manual mode on some events (sleep/resume); take
            # it back rather than silently leaving the fan to its own curve.
            if read_int(enable) != fan.manual:
                write_int(enable, fan.manual)
                write_int(target, current)

            write_status({
                "mode": mode,
                "cpuTemp": temps.get("cpu"),
                "gpuTemp": temps.get("gpu"),
                # The sensor driving the fan: its name ("cpu", "gpu" or an SMC
                # key such as TM1a), its kind and its temperature.
                "sensor": driver[0] if driver else None,
                "source": driver[1] if driver else None,
                "hottest": driver[2] if driver else None,
                "target": current,
                "rpm": read_int(os.path.join(smc, "fan1_input")),
                "min": lo,
                "max": hi,
                "time": time.time(),
            })
            time.sleep(INTERVAL)
    finally:
        release(fan)


if __name__ == "__main__":
    sys.exit(main())
