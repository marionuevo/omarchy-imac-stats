#!/bin/sh
# Make power-profiles-daemon's profiles actually do something on this iMac.
#
# The i5-4690 is a Haswell without HWP, so the kernel runs intel_pstate in
# passive mode and power-profiles-daemon has nothing to write but the
# energy-performance bias, which Haswell all but ignores: power-saver still
# turbos to 3.9 GHz and 64 W. This applies real limits for each profile:
# turbo, max frequency, governor, the RAPL long-term limit (PL1) and the
# Radeon's DPM level.
#
# Run by imac-power-profile.path whenever power-profiles-daemon rewrites its
# state file, and once at boot (the firmware resets RAPL on every boot).
set -u
TAG=imac-power-profile
STATE=/var/lib/power-profiles-daemon/state.ini
SAVED=/var/lib/imac-power
RAPL=/sys/class/powercap/intel-rapl:0
PSTATE=/sys/devices/system/cpu/intel_pstate

# power-saver limits. 2.4 GHz and 35 W keep the desktop responsive while
# roughly halving package power under load.
SAVER_MAX_KHZ=2400000
SAVER_PL1_UW=35000000

profile=$(sed -n 's/^Profile=//p' "$STATE" 2>/dev/null)
[ -n "$profile" ] || profile=balanced

# The firmware's own PL1 (100 W on this iMac, above Intel's 84 W TDP) is
# remembered the first time through, so balanced/performance put back
# exactly what Apple set rather than a guess.
mkdir -p "$SAVED"
if [ ! -s "$SAVED/pl1-default" ] && [ -r "$RAPL/constraint_0_power_limit_uw" ]; then
  cat "$RAPL/constraint_0_power_limit_uw" > "$SAVED/pl1-default"
fi
pl1_default=$(cat "$SAVED/pl1-default" 2>/dev/null)

put() {
  [ -e "$1" ] || return 0
  echo "$2" > "$1" 2>/dev/null || logger -t "$TAG" "write failed: $1 <- $2"
}

case "$profile" in
  power-saver)
    # The Radeon stays on auto: pinned to its lowest DPM level it could not
    # keep up with a 4K stream at 60 fps (imac-display receiver) and hung
    # the gfx ring. It idles at the bottom level on auto anyway.
    no_turbo=1; governor=schedutil; max_khz=$SAVER_MAX_KHZ
    pl1=$SAVER_PL1_UW; gpu=auto ;;
  performance)
    no_turbo=0; governor=performance; max_khz=
    pl1=$pl1_default; gpu=auto ;;
  *)
    no_turbo=0; governor=schedutil; max_khz=
    pl1=$pl1_default; gpu=auto ;;
esac

put "$PSTATE/no_turbo" "$no_turbo"
for cpu in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
  put "$cpu/scaling_governor" "$governor"
  put "$cpu/scaling_max_freq" "${max_khz:-$(cat "$cpu/cpuinfo_max_freq")}"
done
[ -n "$pl1" ] && put "$RAPL/constraint_0_power_limit_uw" "$pl1"
for dpm in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
  put "$dpm" "$gpu"
done

logger -t "$TAG" "$profile: no_turbo=$no_turbo governor=$governor max=${max_khz:-full} pl1=${pl1:-unchanged} gpu=$gpu"
